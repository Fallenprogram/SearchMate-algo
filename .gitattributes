# Keep the tested player stable on every checkout.
/agent.py text eol=lf
/.github/** text eol=lf
/.gitattributes text eol=lf
/.gitignore text eol=lf
/README.md text eol=lf

# Frozen research sources and evidence contain LF, CRLF, and mixed-line-ending
# files with byte-level hashes. Preserve all research bytes, including the
# append-only ledger, logs, snapshots, and future champion/release records.
/research/** -text diff whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Raw CI/container logs intentionally retain their original timestamp spacing.
/research/releases/**/ci-logs/** -whitespace
/research/releases/**/linux-compatibility/*.txt -whitespace

# Preserve the v14 release ZIP and generated table data as binary artifacts.
/research/releases/competition-v4-internal-v14-01/*.zip binary
/research/releases/competition-v4-internal-v14-01/player/tables/*.rtbw binary
/research/releases/competition-v4-internal-v14-01/player/tables/*.rtbz binary

# Preserve exact v16 submission data.
/research/releases/competition-v5-internal-v16-01/*.zip binary
/research/releases/competition-v5-internal-v16-01/player/tables/* binary

# Preserve exact v37 source weights and release archive.
/research/releases/competition-v6-internal-v37-01/*.zip binary
/research/releases/competition-v6-internal-v37-01/player/evaluation.npz binary
/research/releases/competition-v6-internal-v37-01/player/tables/* binary
# Keep even the frozen source whitespace byte-identical to its tested ZIP.
/research/releases/competition-v6-internal-v37-01/player/agent.py -whitespace

# Preserve the exact final v39 release payload.
/research/releases/final-internal-v39-01/*.zip binary
/research/releases/final-internal-v39-01/player/evaluation.npz binary
/research/releases/final-internal-v39-01/player/tables/* binary
/research/releases/final-internal-v39-01/player/agent.py -whitespace
